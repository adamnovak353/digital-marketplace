# Copy to .env. Never commit real secrets.
# In production, load these from a cloud secrets manager (AWS Secrets Manager or equivalent).

NODE_ENV=development
DEMO_MODE=true

# Required outside local demo: random values of 32+ characters. Production refuses to start otherwise.
# Changing INVENTORY_ENC_KEY after launch makes stored inventory unreadable.
SESSION_SECRET=replace-with-a-long-random-string
INVENTORY_ENC_KEY=replace-with-a-long-random-string
WEBHOOK_SECRET=replace-with-a-long-random-string

# Where marketplace data is saved after every change.
#   file     - JSON file at STATE_FILE (default for local development)
#   postgres - one row in the marketplace_state table at DATABASE_URL (production)
#   memory   - nothing survives a restart (tests only; refused in production)
# Run exactly one app process against a given database or file.
PERSISTENCE=file
STATE_FILE=.data/marketplace-state.json
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
REDIS_URL=redis://localhost:6379

# First start with an empty store:
#   DEMO_MODE=true  -> seeds the labeled demo catalog and demo accounts (unless SEED_DEMO=false)
#   DEMO_MODE=false -> creates only this administrator (MFA on). Required for a real launch.
SEED_DEMO=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Leave blank unless a real provider is approved. Mock adapters stay active.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email. Required in production: sign-in codes, verification and reset links are emailed.
# Example: smtps://USER:PASSWORD@smtp.your-provider.com:465  (use your provider's real values)
# When unset, DEMO_MODE=true shows codes and links on screen instead; DEMO_MODE=false disables them.
SMTP_URL=
MAIL_FROM=
# Address customers use; emailed links point here. Must be https:// in production.
PUBLIC_URL=http://localhost:3000
# Optional inbox that gets a copy of every new order request (sellers are always emailed).
ORDER_ALERT_EMAIL=

# Approved-provider credentials. Do not invent values.
PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=mock
CARD_ISSUER_PROVIDER=mock
TELECOM_PROVIDER=mock

WEB_ORIGIN=http://localhost:3000
API_PORT=4000
WORKER_PORT=4001

# Customer-facing service fee and reseller commission in basis points.
CUSTOMER_FEE_BPS=300
COMMISSION_BPS=1000

# Keep off until a licensed telecom or card-issuing contract is approved.
FEATURE_TELECOM=false
FEATURE_CARDS=false
